# ManifoldGen
DATABASE_URL=postgres://manifoldgen:manifoldgen@localhost:5432/manifoldgen?sslmode=disable
PORT=8116
DEV=true
FRONTEND_URL=http://localhost:3006
DIST_DIR=frontend/out

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=

# app.nz H3 video (customer rate ≈ $2.24/GPU-hr; ManifoldGen +20% => $2.688)
APPNZ_BASE_URL=https://app.nz
APPNZ_API_KEY=
H3_VIDEO_PRICE_USD_PER_GPU_HOUR=2.688

# Optional local LTX via omniserve-native
OMNISERVE_NATIVE_URL=http://127.0.0.1:8791
ZIMAGE_BACKEND_URL=http://127.0.0.1:8100
IMAGES_DIR=/nvme0n1-disk/manifoldgen-images
GOBED_MODEL_PATH=/nvme0n1-disk/code/gobed/model
FAL_KEY=
FAL_API_KEY=

# Uploads / email (optional)
R2_PATH_PREFIX=manifoldgen/uploads
SES_FROM_EMAIL=hello@manifoldgen.com
SES_FROM_NAME=ManifoldGen
