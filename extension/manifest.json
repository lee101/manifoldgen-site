{
  "manifest_version": 3,
  "name": "ManifoldGen Everywhere",
  "version": "1.0.0",
  "description": "Turn anything you see on the web into polished ManifoldGen and Netwrck content.",
  "permissions": ["contextMenus", "tabs"],
  "host_permissions": [
    "<all_urls>",
    "https://manifoldgen.com/*",
    "https://netwrck.com/*",
    "https://images3.netwrck.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {
    "default_title": "Create with ManifoldGen",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
