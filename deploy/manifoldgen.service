[Unit]
Description=ManifoldGen video studio
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/manifoldgen-site
EnvironmentFile=/opt/manifoldgen-site/.env
Environment=GOBED_MODEL_PATH=/nvme0n1-disk/code/gobed/model
ExecStart=/opt/manifoldgen-site/server/manifoldgen-server
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
