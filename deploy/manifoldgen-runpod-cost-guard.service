[Unit]
Description=ManifoldGen conservative RunPod cost guard
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=administrator
Group=administrator
WorkingDirectory=/opt/manifoldgen-site
EnvironmentFile=/opt/manifoldgen-site/.env
StateDirectory=manifoldgen-runpod-guard
StateDirectoryMode=0755
Environment=HOME=/home/administrator
Environment=AWS_SES_ALERT_TO=lee.penkman@netwrck.com
Environment=MONITOR_LOG_DIR=/var/lib/manifoldgen-runpod-guard/alerts
Environment=MONITOR_STATE_DIR=/var/lib/manifoldgen-runpod-guard/alerts
Environment=MONITOR_LOCK_DIR=/tmp/appnz-monitor
ExecStart=/usr/bin/python3 /opt/manifoldgen-site/scripts/runpod_cost_guard.py --apply --threshold 6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/manifoldgen-runpod-guard
