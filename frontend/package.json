{
  "name": "manifoldgen-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev --turbopack --port 3006",
    "dev:https": "../scripts/dev-https.sh",
    "build": "NEXT_OUTPUT=export next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:standalone": "next build",
    "test:e2e": "playwright test",
    "test:e2e:hook": "playwright test tests/e2e/studio-media.spec.js tests/e2e/api-pricing.spec.js --grep-invert 'visual fidelity benchmark|2K preview stays'",
    "test:e2e:perf": "PLAYWRIGHT_GPU=1 PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=${PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH:-/usr/bin/google-chrome} playwright test tests/e2e/studio-media.spec.js --grep '2K preview'",
    "test:e2e:export-visual": "NEXT_DIST_DIR=.next-export-visual PLAYWRIGHT_PORT=3237 PLAYWRIGHT_WORKERS=1 PLAYWRIGHT_AV1=1 playwright test tests/e2e/studio-media.spec.js --grep 'visual fidelity benchmark'"
  },
  "dependencies": {
    "lucide-react": "^0.553.0",
    "mediabunny": "^1.53.0",
    "next": "^15.4.9",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  }
}
