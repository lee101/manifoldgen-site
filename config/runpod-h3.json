{
  "image": "ghcr.io/lee101/h3-cog:cu130-20260810-r5",
  "dockerStartCmd": ["python", "-u", "/src/rp_handler.py"],
  "workersMin": 0,
  "idleTimeout": 5,
  "executionTimeoutMs": 14400000,
  "flashboot": true,
  "scalerType": "QUEUE_DELAY",
  "scalerValue": 4,
  "endpoints": [
    {
      "name": "cog-manifold-h3-normal",
      "workersMax": 2,
      "gpuTypeIds": [
        "NVIDIA A40",
        "NVIDIA RTX A6000",
        "NVIDIA RTX 6000 Ada Generation",
        "NVIDIA L40",
        "NVIDIA L40S"
      ]
    },
    {
      "name": "cog-manifold-h3-pinkcherry",
      "workersMax": 1,
      "gpuTypeIds": [
        "NVIDIA A100 80GB PCIe",
        "NVIDIA A100-SXM4-80GB",
        "NVIDIA H100 PCIe",
        "NVIDIA H100 80GB HBM3",
        "NVIDIA H100 NVL"
      ]
    }
  ],
  "notes": "Both variants must use the native RunPod handler, never the Cog HTTP command. The native handler lets RunPod cancellation terminate active work so canceled jobs do not leave billed orphan workers. Five-second idle shutdown is below the 30-second cost ceiling."
}
