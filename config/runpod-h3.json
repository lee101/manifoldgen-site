{
  "image": "ghcr.io/lee101/h3-cog:cu130-20260826-face-judge-r7",
  "dockerStartCmd": ["python", "-u", "/src/rp_handler.py"],
  "env": {
    "H3_ACCEL_PROFILE": "balanced",
    "H3_ATTENTION_BACKEND": "ck",
    "H3_FACE_REFINE_ENABLED": "0",
    "H3_FACE_REFINE_REQUIRED": "0",
    "H3_FACE_REFINE_VISION_JUDGE": "1",
    "H3_FACE_REFINE_GATE_SAMPLES": "7",
    "H3_FACE_REFINE_PREVIEW_FRAMES": "5",
    "H3_FACE_REFINE_TARGET_FACE_FRACTION": "0.12",
    "H3_FACE_REFINE_CROP_FACTOR": "2.2",
    "H3_FACE_REFINE_CANVAS": "512",
    "H3_FACE_REFINE_SMALL_STRENGTH": "1.0",
    "H3_FACE_REFINE_CONDITIONING": "image",
    "H3_FACE_REFINE_MIN_FACE_FRACTION": "0.07",
    "H3_FACE_REFINE_DETECTOR": "face_yolov8m.pt",
    "H3_FACE_REFINE_FALLBACK_DETECTOR": "none",
    "H3_FACE_JUDGE_URL": "https://openpaths.io/v1/chat/completions",
    "H3_FACE_JUDGE_MODEL": "deepseek-v4-flash-vision-exp",
    "H3_FACE_JUDGE_MIN_CONFIDENCE": "0.75",
    "H3_FACE_REFINE_MIN_DETAIL_GAIN_RATIO": "1.02",
    "H3_MODEL_SET": "fl2va,ref2va",
    "H3_LAZY_REF2VA": "1",
    "H3_LATENT_UPSCALE_ENABLED": "0",
    "H3_LATENT_UPSCALER_MODEL": "h3_clean_latent_upscaler_film_epoch200.safetensors"
  },
  "forwardEnv": {
    "H3_FACE_JUDGE_API_KEY": "OPENPATHS_API_KEY"
  },
  "workersMin": 0,
  "idleTimeout": 5,
  "executionTimeoutMs": 14400000,
  "flashboot": true,
  "scalerType": "REQUEST_COUNT",
  "scalerValue": 1,
  "endpoints": [
    {
      "id": "snzfeqekxdmw1v",
      "templateId": "8f03l2lyj6",
      "name": "cog-manifold-h3-normal",
      "workersMax": 2,
      "gpuTypeIds": [
        "NVIDIA H100 PCIe",
        "NVIDIA H100 80GB HBM3",
        "NVIDIA H100 NVL"
      ],
      "unsetEnv": ["H3_FACE_REFINE_LORA", "H3_FACE_REFINE_STEPS"]
    },
    {
      "id": "811c0jb28shcnr",
      "templateId": "tod8ekrmft",
      "name": "cog-manifold-h3-pinkcherry",
      "workersMax": 1,
	  "env": {
		"H3_FL2VA_REPO": "SexGod1979/PinkCherry_MiniMax-H3",
		"H3_FL2VA_HF_FILENAME": "beta-0.6-fl2va/PinkCherry_fl2va_MiniMax_H3_pruned_int8_convrot-beta-0.6.safetensors",
		"H3_FL2VA_MODEL": "PinkCherry_fl2va_MiniMax_H3_pruned_int8_convrot-beta-0.6.safetensors",
		"H3_FL2VA_REVISION": "f71e0eee7c0414904b66c4efa617c34548dd2bb0"
	  },
      "gpuTypeIds": [
        "NVIDIA H100 PCIe",
        "NVIDIA H100 80GB HBM3",
        "NVIDIA H100 NVL"
      ]
    }
  ],
  "notes": "Both variants use the native handler and scale to zero after five idle seconds. H100 remains the validated default; REF2VA is an allowed lazy capability so text/video cold starts do not pay its load cost, while image edits load it on demand. Studio 1939 was removed after every representative A/B preferred base H3 on coherence and prompt adherence. The H3 face-refine pass is disabled and omitted from H3_MODEL_SET: repeated single- and multi-face audits found skips, no visible gain, or substantial detail loss. Re-enable only for a different restorer that wins a representative temporal A/B. PinkCherry beta-0.6 remains pinned to an immutable revision. A40 remains excluded after second-pass crashes."
}
