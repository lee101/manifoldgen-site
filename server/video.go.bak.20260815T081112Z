func isRunPodWorkersQuotaErr(err error) bool {
	if err == nil {
		return false
	}
	msg := strings.ToLower(err.Error())
	return strings.Contains(msg, "workers quota") || strings.Contains(msg, "max workers across all endpoints")
}

