+def test_eager_init_builds_default_runtime_once(monkeypatch):
+    import threading as _threading
+
+    created = []
+    release = _threading.Event()
+
+    class Runtime:
+        def __init__(self, **kwargs):
+            assert release.wait(5)
+            self.vram_mode = kwargs["vram_mode"]
+            self.attention_backend = kwargs["attention_backend"]
+            self.benchmark_mode = kwargs["benchmark_mode"]
+            created.append(self)
+
+        def close(self):
+            pass
+
+    class Moderation:
+        def _nsfw_model(self):
+            return None
+
+        def _age_model(self):
+            return None
+
+    monkeypatch.setattr(rp_handler, "H3Runtime", Runtime)
+    monkeypatch.setattr(rp_handler, "Moderation", Moderation)
+    monkeypatch.delenv("H3_COMFY_VRAM_MODE", raising=False)
+    monkeypatch.delenv("H3_ATTENTION_BACKEND", raising=False)
+    rp_handler._runtime = None
+    rp_handler._moderation = None
+
+    threads = rp_handler.start_eager_init()
+    result = {}
+    job = _threading.Thread(target=lambda: result.setdefault("runtime", rp_handler._get_runtime()))
+    job.start()
+    release.set()
+    job.join(5)
+    for thread in threads:
+        thread.join(5)
+
+    assert len(created) == 1
+    assert result["runtime"] is created[0]
+    rp_handler._runtime = None
+    rp_handler._moderation = None
+
+
+def test_eager_init_is_opt_in(monkeypatch):
+    monkeypatch.delenv("H3_EAGER_INIT", raising=False)
+    assert rp_handler._eager_init_enabled() is False
+    monkeypatch.setenv("H3_EAGER_INIT", "1")
+    assert rp_handler._eager_init_enabled() is True

