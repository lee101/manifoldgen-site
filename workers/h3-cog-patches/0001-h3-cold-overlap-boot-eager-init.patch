+def _eager_init_enabled() -> bool:
+    return os.getenv("H3_EAGER_INIT", "").strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _eager_init() -> None:
+    """Build the default runtime at container start instead of on the first job.
+
+    The first job's input downloads and RunPod hand-off then overlap the weight
+    fetch and ComfyUI boot; the job blocks on _runtime_lock until it is ready.
+    A failure here is only logged: the job path retries construction.
+    """
+    started = time.monotonic()
+    try:
+        _get_runtime()
+        print(f"H3 eager init ready in {time.monotonic() - started:.1f}s", flush=True)
+    except Exception as exc:
+        print(f"H3 eager init failed after {time.monotonic() - started:.1f}s: {exc}", flush=True)
+
+
+def _preload_moderation() -> None:
+    try:
+        moderation = _get_moderation()
+        moderation._nsfw_model()
+        moderation._age_model()
+    except Exception as exc:
+        print(f"H3 moderation preload failed: {exc}", flush=True)
+
+
+def start_eager_init() -> list[threading.Thread]:
+    threads = [
+        threading.Thread(target=_eager_init, name="h3-eager-init", daemon=True),
+        threading.Thread(target=_preload_moderation, name="h3-moderation-preload", daemon=True),
+    ]
+    for thread in threads:
+        thread.start()
+    return threads
+
+
 if __name__ == "__main__":
