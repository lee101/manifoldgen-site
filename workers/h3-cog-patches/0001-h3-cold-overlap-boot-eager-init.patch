+def test_comfy_boot_overlaps_weight_fetch(monkeypatch):
+    import threading as _threading
+
+    events = []
+    fetch_started = _threading.Event()
+    boot_started = _threading.Event()
+
+    class Process:
+        def poll(self):
+            return 0
+
+        def terminate(self):
+            events.append("terminate")
+
+    def ensure(**kwargs):
+        fetch_started.set()
+        assert boot_started.wait(5), "ComfyUI boot did not start while weights were fetching"
+        events.append(("weights", kwargs["include_ref2va"]))
+
+    def start(self):
+        boot_started.set()
+        assert fetch_started.wait(5), "weight fetch did not start while ComfyUI booted"
+        events.append("boot")
+        return Process()
+
+    monkeypatch.delenv("H3_OVERLAP_BOOT", raising=False)
+    monkeypatch.setenv("H3_LAZY_REF2VA", "1")
+    monkeypatch.setattr(h3_runtime, "ensure_weights", ensure)
+    monkeypatch.setattr(H3Runtime, "_start_comfy", start)
+    monkeypatch.setattr(h3_runtime, "EndpointFaceDetector", lambda **_kwargs: object())
+
+    runtime = H3Runtime(model_profile="audio")
+    assert sorted(map(str, events)) == sorted(map(str, ["boot", ("weights", False)]))
+    runtime.close()
+
+
+def test_weight_fetch_failure_stops_booted_comfy(monkeypatch):
+    stopped = []
+
+    class Process:
+        def poll(self):
+            return None
+
+        def terminate(self):
+            stopped.append(True)
+
+    def ensure(**_kwargs):
+        raise RuntimeError("r2 unavailable")
+
+    monkeypatch.delenv("H3_OVERLAP_BOOT", raising=False)
+    monkeypatch.setattr(h3_runtime, "ensure_weights", ensure)
+    monkeypatch.setattr(H3Runtime, "_start_comfy", lambda self: Process())
+    monkeypatch.setattr(h3_runtime, "EndpointFaceDetector", lambda **_kwargs: object())
+
+    with pytest.raises(RuntimeError, match="r2 unavailable"):
+        H3Runtime()
+    assert stopped == [True]
+
+
+def test_overlap_boot_can_be_disabled(monkeypatch):
+    order = []
+
+    class Process:
+        def poll(self):
+            return 0
+
+    monkeypatch.setenv("H3_OVERLAP_BOOT", "0")
+    monkeypatch.setattr(h3_runtime, "ensure_weights", lambda **_kwargs: order.append("weights"))
+    monkeypatch.setattr(H3Runtime, "_start_comfy", lambda self: order.append("boot") or Process())
+    monkeypatch.setattr(h3_runtime, "EndpointFaceDetector", lambda **_kwargs: object())
+
+    runtime = H3Runtime()
+    assert order == ["weights", "boot"]
+    runtime.close()
