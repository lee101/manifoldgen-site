+    def _start_comfy_with_weights(self, weight_kwargs: dict) -> subprocess.Popen:
+        """Boot ComfyUI while the weights download/verify.
+
+        ComfyUI's interpreter, CUDA and custom-node import do not read model
+        files (model lists are re-scanned when a prompt is validated), so the
+        cold path costs max(boot, fetch) instead of boot + fetch. The weights
+        and the generation graph are unchanged.
+        """
+        result: dict[str, BaseException | None] = {"error": None}
+
+        def fetch() -> None:
+            try:
+                ensure_weights(**weight_kwargs)
+            except BaseException as exc:  # re-raised on the caller's thread
+                result["error"] = exc
+
+        started = time.monotonic()
+        fetcher = threading.Thread(target=fetch, name="h3-weights", daemon=True)
+        fetcher.start()
+        try:
+            process = self._start_comfy()
+        except BaseException:
+            fetcher.join()
+            raise
+        boot_seconds = time.monotonic() - started
+        fetcher.join()
+        if result["error"] is not None:
+            terminate = getattr(process, "terminate", None)
+            if callable(terminate) and process.poll() is None:
+                terminate()
+            raise result["error"]
+        print(
+            f"H3 cold start: comfy_boot={boot_seconds:.1f}s "
+            f"boot+weights={time.monotonic() - started:.1f}s (overlapped)",
+            flush=True,
+        )
+        return process
+
